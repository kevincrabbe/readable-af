{
  "name": "eslint-plugin-readable-af",
  "version": "0.1.1",
  "description": "Opinionated ESLint rules and presets for boolean expressions that are easy to read and reason about.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --experimental-test-coverage '--test-coverage-include=dist/**/*.js' --test-coverage-lines=90 --test-coverage-branches=90 tests/*.test.js",
    "lint": "npm run build && eslint .",
    "check": "npm run typecheck && npm test && npm run lint",
    "prepack": "npm run check"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "readability",
    "clean-code",
    "boolean"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevincrabbe/readable-af.git"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "peerDependencies": {
    "eslint": "^9.0.0 || ^10.0.0",
    "typescript": ">=4.8.4 <6.1.0"
  },
  "dependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/utils": "^8.69.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "typescript-eslint": "^8.69.0"
  },
  "devDependencies": {
    "@typescript-eslint/rule-tester": "^8.69.0",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3"
  }
}
